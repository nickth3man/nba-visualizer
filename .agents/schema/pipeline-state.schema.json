{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.nba-visualizer/.agents/schema/pipeline-state.schema.json",
  "title": "Agent Pipeline State",
  "type": "object",
  "required": [
    "active_task",
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "active_task": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]*$": {
          "type": "object",
          "required": [
            "description",
            "created_at"
          ],
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "created_at": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        }
      }
    }
  }
}
